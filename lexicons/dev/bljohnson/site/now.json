{
  "lexicon": 1,
  "id": "dev.bljohnson.site.now",
  "defs": {
    "main": {
      "type": "record",
      "description": "Current 'now' status for bljohnson.dev - home sensor readings, toggles (lights, etc.), and what I'm watching. Ingested periodically from Home Assistant and Mishos (self-hosted tv tracking) via the site's status ingest endpoint.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["updatedAt"],
        "properties": {
          "updatedAt": { "type": "string", "format": "datetime" },
          "entities": {
            "type": "unknown",
            "description": "Map of entity id -> #tempEntity or #toggleEntity, discriminated by `type`. Lexicon has no map primitive; the shape is enforced in-app with Zod (src/lib/schemas/status-ingest.ts)."
          },
          "nowWatching": { "type": "ref", "ref": "#nowWatching" }
        }
      }
    },
    "tempEntity": {
      "type": "object",
      "required": ["type", "label", "tempF", "updatedAt"],
      "properties": {
        "type": { "type": "string", "const": "temp" },
        "label": { "type": "string" },
        "tempF": {
          "type": "string",
          "description": "Fahrenheit, one decimal place. Stored as a string because the atproto data model forbids floats."
        },
        "humidity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Optional - omitted for entities where only temperature matters."
        },
        "updatedAt": { "type": "string", "format": "datetime" }
      }
    },
    "toggleEntity": {
      "type": "object",
      "required": ["type", "label", "on", "updatedAt"],
      "properties": {
        "type": { "type": "string", "const": "toggle" },
        "label": { "type": "string" },
        "on": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "datetime" }
      }
    },
    "nowWatching": {
      "type": "object",
      "required": ["show", "season", "episode", "watchedAt"],
      "properties": {
        "show": { "type": "string" },
        "season": { "type": "integer", "minimum": 1 },
        "episode": { "type": "integer", "minimum": 1 },
        "episodeTitle": { "type": "string" },
        "watchedAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
